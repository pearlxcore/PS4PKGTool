<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PS4 PKG Tool</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Replaces the SDK's default manifest so the process is per-monitor
         v2 DPI-aware from the very first window (fixes blurry text on
         scaled displays). See app.manifest for the full rationale. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>PackageIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>bin\x86\Debug\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\x86\Release\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup>
    <TargetZone>LocalIntranet</TargetZone>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateManifests>false</GenerateManifests>
    <AssemblyTitle>PS4 PKG Tool</AssemblyTitle>
    <Product>PS4 PKG Tool</Product>
    <Copyright>Copyright © pearlxcore</Copyright>
    <!-- Note: GenerateAssemblyInfo=false, so these are not used at build time.
         The real version attributes live in Properties/AssemblyInfo.cs — keep them in sync. -->
    <AssemblyVersion>1.9.0.0</AssemblyVersion>
    <StartupObject>PS4PKGTool.Program</StartupObject>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <FileVersion>1.9.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Utilities\PkgInspection\PkgExtractionService.cs" />
    <Compile Remove="Utilities\Ffpfsc\**\*.cs" />
    <Compile Remove="Utilities\PkgMeta\PkgMetadata.cs" />
    <Compile Remove="Utilities\PkgMeta\PkgMetadataReader.cs" />
    <Compile Remove="Utilities\PkgMeta\PkgSystemVersion.cs" />
    <Compile Remove="Utilities\PkgDirectoryScanner.cs" />
    <Compile Remove="Utilities\TaskQueue\TaskQueueService.cs" />
    <!-- Keep one-off local validation intermediates out of the SDK compile glob. -->
    <Compile Remove="obj-task-ui-validation/**/*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <Compile Update="Forms\Main\PkgMergeProgressForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\Main\PkgMergeProgressForm.Designer.cs">
      <DependentUpon>PkgMergeProgressForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ByteSize" Version="2.1.1" />
    <PackageReference Include="ClosedXML" Version="0.102.0" />
    <PackageReference Include="DotNetZip" Version="1.13.8" />
    <PackageReference Include="GitHubUpdate" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="7.0.0" />
    <PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
    <PackageReference Include="semver" Version="2.3.0" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- ProjectReference (not a raw DLL reference): guarantees every build
         compiles the sibling DarkUI checkout, so DPI/theme fixes in DarkUI
         always flow into the app instead of silently loading a stale DLL. -->
    <ProjectReference Include="..\..\DarkUI\DarkUI\DarkUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PS4PKGTool.Assets\PS4PKGTool.Assets.csproj" />
    <ProjectReference Include="..\PS4PKGTool.Core\PS4PKGTool.Core.csproj" />
    <ProjectReference Include="..\..\OrbisPkgTool\OrbisPkgTool\OrbisPkgTool.csproj"
                      Condition="'$(PublishSingleFile)' != 'true'" />
    <!-- An executable ProjectReference cannot participate in a framework-dependent
         single-file publish. Build its library first and embed that output instead. -->
    <Reference Include="OrbisPkgTool" Condition="'$(PublishSingleFile)' == 'true'">
      <HintPath>..\..\OrbisPkgTool\OrbisPkgTool\bin\$(Configuration)\net10.0-windows\OrbisPkgTool.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- OrbisPkgTool is referenced in-process as a DLL. Its own CLI artifacts
       are copied by the project reference but are not used by this app. -->
  <Target Name="RemoveUnusedOrbisPkgToolCliArtifacts" AfterTargets="Build">
    <Delete Files="$(TargetDir)OrbisPkgTool.exe;
                   $(TargetDir)OrbisPkgTool.deps.json;
                   $(TargetDir)OrbisPkgTool.runtimeconfig.json;
                   $(TargetDir)OrbisPkgTool.pdb" />
  </Target>
  <Target Name="BuildOrbisPkgToolLibraryForSingleFilePublish"
          BeforeTargets="ResolveReferences"
          Condition="'$(PublishSingleFile)' == 'true'">
    <MSBuild Projects="..\..\OrbisPkgTool\OrbisPkgTool\OrbisPkgTool.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);DebugType=portable;PublishSingleFile=false;SelfContained=false;RuntimeIdentifier=" />
  </Target>
  <Target Name="RemoveLegacyAppConfigFromSingleFilePublish"
          AfterTargets="Publish"
          Condition="'$(PublishSingleFile)' == 'true'">
    <!-- App.config is retained solely for build compatibility; .NET 10 does not use it. -->
    <ItemGroup>
      <SingleFilePublishSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="$(PublishDir)$(TargetName).dll.config;@(SingleFilePublishSymbols)" />
    <!-- The OrbisPkgTool CLI is referenced in-process as a DLL (bundled into the
         single file); its own apphost/deps/runtimeconfig are not part of the app. -->
    <Delete Files="$(PublishDir)OrbisPkgTool.exe;
                   $(PublishDir)OrbisPkgTool.deps.json;
                   $(PublishDir)OrbisPkgTool.runtimeconfig.json;
                   $(PublishDir)OrbisPkgTool.pdb" />
  </Target>
</Project>
